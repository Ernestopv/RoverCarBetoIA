# RoverCarBeto configuration.
# Copy this file to `.env` and adjust the values for your environment.
# Never commit the real `.env` file or any secret in this example file.

# --- General -----------------------------------------------------------------
APP_NAME=RoverCarBeto
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Modes -------------------------------------------------------------------
# ROVER_MODE:  simulator | hardware
# CAMERA_MODE: simulator | imx500
ROVER_MODE=simulator
CAMERA_MODE=simulator

# --- Camera and live video ---------------------------------------------------
# Start the video publisher together with the API. Set to false to run the
# backend without touching the camera at all.
CAMERA_AUTOSTART=true
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_BITRATE_KBPS=2500
# Stream path inside MediaMTX. The browser reaches it at
# http://<host>:<webrtc_port>/<stream_path>/whep
CAMERA_STREAM_PATH=rover

# --- Real camera (Phase 5b, Raspberry Pi only) --------------------------------
# Neural network loaded ON the IMX500 sensor. Models are available in
# /usr/share/imx500-models/ (imx500-all). CAMERA_MODE=imx500 needs it.
#
# SSD-MobileNetV2 is used because it returns boxes already normalized 0..1 and
# without aspect-ratio handling. efficientdet_lite0 also works, but it declares
# preserve_aspect_ratio and that shifts all the boxes.
CAMERA_NETWORK_FILE=/usr/share/imx500-models/imx500_network_ssd_mobilenetv2_fpnlite_320x320_pp.rpk
# Number of capture buffers for Picamera2. Fewer buffers = less latency.
# 3 is a reasonable minimum; below that frames are dropped.
CAMERA_BUFFER_COUNT=3
# Video mirror, in case the camera is mounted upside down or inverted.
# 180 degrees = CAMERA_HFLIP=true and CAMERA_VFLIP=true at the same time.
CAMERA_HFLIP=false
CAMERA_VFLIP=false

# --- MediaMTX -----------------------------------------------------------------
# Host as seen by the backend (the compose service name in containers).
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889

# --- Safety limits -----------------------------------------------------------
# Motion values are normalized to the [-1, 1] range and then clamped to these
# limits. They are the last line of defense: never raise them without a reason.
MAX_LINEAR_SPEED=1.0
MAX_ANGULAR_SPEED=1.5

# Watchdog: if no new motion command arrives within this many seconds, the rover
# is stopped automatically. Never leave a motion command active indefinitely.
COMMAND_TIMEOUT=0.5
WATCHDOG_INTERVAL=0.1

# --- WAVE ROVER Wi-Fi connection (Phase 4) -----------------------------------
# Values must match the official WAVE ROVER documentation for your unit.
# The chassis creates its own access point named "UGV" and answers on
# 192.168.4.1; the Raspberry Pi joins it with a second interface.
WAVE_ROVER_HOST=192.168.4.1
WAVE_ROVER_PORT=80
WAVE_ROVER_TIMEOUT=1.0
# Transport: "wifi" (default) or "serial" (header UART at 115200, /dev/ttyAMA0).
# Serial is opt-in until benched and trusted; it needs the header UART enabled
# (config.txt: dtparam=uart0=on + dtoverlay=disable-bt) and no console on it.
WAVE_ROVER_TRANSPORT=wifi
WAVE_ROVER_SERIAL_PORT=/dev/ttyAMA0
# The protocol takes wheel speeds in +-0.5, where 0.5 is 100% PWM. Internal
# commands are normalised to +-1, so 1.0 maps to this value.
WAVE_ROVER_MAX_SPEED=0.5
# 3S Li-ion pack discharge curve, as (voltage_V, percentage) pairs.
# It is what turns the voltage reported by the chassis into a charge level.
# It can be overridden with JSON, e.g.:
#   WAVE_ROVER_BATTERY_CURVE=[[12.6,100],[12.15,85],[9.9,0]]
WAVE_ROVER_BATTERY_CURVE=[[12.60,100],[12.15,85],[11.91,70],[11.67,55],[11.40,40],[11.10,25],[10.80,12],[10.50,5],[10.20,2],[9.90,0]]
# Chassis speed rate, 0..1 (1 = maximum). It is applied on connect ONLY if the
# chassis has it at 0, because its boot.mission resets it on every startup and
# with 0 the chassis ignores all motion commands.
WAVE_ROVER_SPEED_RATE=1.0
# Per-wheel trim (1.0 = no correction). If the robot drifts while going straight,
# lower the side that runs faster: 0.9 corrects 10% of excess speed.
WAVE_ROVER_LEFT_TRIM=1.0
WAVE_ROVER_RIGHT_TRIM=1.0

# --- AI (Phase 6) -------------------------------------------------------------
# Minimum confidence to report an object. Lowering it shows more detections
# (including doubtful ones); raising it keeps only the clear ones.
AI_SCORE_THRESHOLD=0.5

# Minimum confidence for the pose network to consider that there is a person.
# It is a separate setting on purpose: the two networks do NOT score on the same
# scale (the official detection example uses 0.55 and the pose one uses 0.3).
# Only used when CAMERA_NETWORK_FILE points to a pose network, e.g.
#   imx500_network_higherhrnet_coco.rpk
AI_POSE_THRESHOLD=0.3

# --- Behaviour: person following (Phase 7) ------------------------------------
# A chaser, disabled by default: no autonomous motion until an operator enables it
# via POST /api/v1/behavior/follow (or FOLLOW_AUTO_ENABLE=true at startup).
# Commands still pass through the safety layer, and the rover never reverses.
FOLLOW_AUTO_ENABLE=false
FOLLOW_TARGET_LABEL=person
FOLLOW_MIN_CONFIDENCE=0.5
# Approach until the person's bbox reaches this height (0..1): the minimum
# distance. Bigger = it gets closer before it stops.
FOLLOW_TARGET_HEIGHT=0.7
FOLLOW_MAX_LINEAR=0.4
FOLLOW_MAX_ANGULAR=0.6
# Smallest forward speed, so static friction does not stall the approach.
FOLLOW_MIN_LINEAR=0.15
FOLLOW_DEADBAND=0.06
# Only drive forward when the person is within this horizontal distance of the
# centre; otherwise it turns in place.
FOLLOW_FACE_DEADBAND=0.2
FOLLOW_LOST_TIMEOUT=10.0

# --- Simulator ---------------------------------------------------------------
# Simulated round-trip latency in seconds.
SIMULATOR_LATENCY=0.0
# Simulated probability (0..1) of a communication failure per command.
SIMULATOR_FAILURE_RATE=0.0
